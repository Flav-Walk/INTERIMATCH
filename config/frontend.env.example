# Frontend — noms uniquement, jamais de valeur réelle dans Git.
# Tout ce qui est préfixé VITE_ finit dans le bundle navigateur : aucune clé serveur ici.

# URL de l'API, préfixe /api/v1 inclus.
VITE_API_URL=

# Supabase côté navigateur : utilisés uniquement pour la connexion Google.
# Absents, le bouton Google affiche un message et l'auth classique continue de fonctionner.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
