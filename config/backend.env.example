# Backend — noms uniquement, jamais de valeur réelle dans Git.
# Référence complète : docs/DEPLOYMENT.md.

# --- Requis pour démarrer ---
NODE_ENV=
PORT=
FRONTEND_URL=

# --- Requis pour les comptes : sans DATABASE_URL, seul /api/v1/health répond ---
# Utiliser le Session Pooler Supabase (port 5432), pas l'hôte direct (IPv6 seul). Voir D08.
DATABASE_URL=
DB_SSL=
# Certificat d'autorité Supabase : vérification TLS active. Obligatoire en production.
DB_SSL_CA_PATH=
# Repli de développement uniquement : le démarrage échoue si NODE_ENV=production.
DB_SSL_INSECURE=

# --- Requis pour la connexion Google ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Ancien nom accepté en repli si SUPABASE_SECRET_KEY est absent.
SUPABASE_SERVICE_ROLE_KEY=

# --- Comptes de démonstration : développement uniquement, jamais en production ---
ALLOW_DEMO_SEED=
DEMO_PASSWORD=

# --- Déclarés et validés, mais AUCUN code ne les utilise encore ---
MONGODB_URI=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
WEBHOOK_SIGNING_SECRET=
