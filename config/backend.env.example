# Configuration optionnelle au Lot 0 ; aucun secret requis pour démarrer.
NODE_ENV=
PORT=
FRONTEND_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
MONGODB_URI=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Clé d'ACCÈS Unsplash (« Access Key » de leur console développeur), utilisée
# côté serveur uniquement : le quota qu'elle porte est celui de l'application
# entière. Ne jamais la préfixer VITE_, ni la recopier côté navigateur.
# Absente, la bibliothèque de photos est simplement désactivée ; l'import depuis
# l'ordinateur reste disponible.
UNSPLASH_ACCESS_KEY=

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
WEBHOOK_SIGNING_SECRET=
